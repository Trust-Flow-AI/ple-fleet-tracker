{
  "name": "ple-fleet-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Pure Light Electric fleet maintenance automation: Bouncie telematics -> Monday.com work orders",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:init": "wrangler d1 execute ple-fleet --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute ple-fleet --local --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
